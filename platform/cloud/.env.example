APP_ENV=production
APP_URL=https://dcp.amradel.com
# Generate a unique key with: openssl rand -base64 48
APP_KEY=
# During key rotation, keep the previous key here until existing device/account tokens have migrated.
APP_KEY_PREVIOUS=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=YOUR_DATABASE
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Generate once with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Keep private; changing it invalidates pinned Cloud terminal signing identity.
DCP_CLOUD_SIGNING_SEED=
