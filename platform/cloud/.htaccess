Options -Indexes
DirectoryIndex index.php
<FilesMatch "^[.].*">
  Require all denied
</FilesMatch>
<FilesMatch "[.](sql|md|txt)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^site[.]php$ - [F,L,NC]
RewriteRule ^token[.]php$ - [F,L,NC]
RewriteRule [.]((sql|md|txt))$ - [F,L,NC]
RewriteRule (^|/)[.] - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
