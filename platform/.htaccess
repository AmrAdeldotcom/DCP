Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The public asset tree is the only directly served application directory.
  RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]

  # Block internal code, scripts, runtime payloads and local user data.
  RewriteRule ^(app|bootstrap|config|cloud|cloud-platform-upload|dcp-env|data|storage|scripts|tests|wrappers|plugins|locales|integrations)(/|$) - [F,L,NC]
  RewriteRule ^public/(?!assets/).*$ - [F,L,NC]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule (^|/)(\.env|composer\.(json|lock)|package(-lock)?\.json|.*\.(sqlite3?|db|key|pem|log|bak|zip))$ - [F,L,NC]

  # Only index.php may execute PHP through Apache.
  RewriteCond %{REQUEST_URI} !/index\.php$
  RewriteRule \.php$ - [F,L,NC]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cache-Control "no-store" env=REDIRECT_STATUS
</IfModule>
