<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DCP</AssemblyName>
    <RootNamespace>DCP</RootNamespace>
    <ApplicationIcon>../../public/assets/dcp.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion Condition="'$(DCPVersion)' != ''">$(DCPVersion)</InformationalVersion>
    <InformationalVersion Condition="'$(DCPVersion)' == ''">1.0.0-alpha.9</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DCPVersion" Value="$(DCPVersion)" Condition="'$(DCPVersion)' != ''" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
  </ItemGroup>
</Project>
